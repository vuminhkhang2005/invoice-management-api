{
  "info": {
    "_postman_id": "8e7c10b4-934d-4e92-bc2f-48e67a07c123",
    "name": "Invoice Management API - Grand Enterprise Edition",
    "description": "Comprehensive Postman Collection for testing Invoice Management RESTful API endpoints, including invoice lifecycle state machine (DRAFT -> ISSUED -> CANCELED / REPLACED), financial calculations, PDF export, VietQR, Automated Email, Batch ZIP, JWT Auth, Analytics, and Audit logs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "invoiceId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. System & Authentication",
      "item": [
        {
          "name": "1.1 Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Check if API service and server are healthy"
          },
          "response": []
        },
        {
          "name": "1.2 Get Demo Accounts & Pre-signed JWT Tokens",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data[0]) {",
                  "    pm.collectionVariables.set('authToken', jsonData.data[0].token);",
                  "    console.log('Saved admin authToken:', jsonData.data[0].token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/demo-accounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "demo-accounts"]
            },
            "description": "Retrieve demo credentials and pre-signed tokens for all 4 roles (Admin, Chief Accountant, Accountant, Auditor)"
          },
          "response": []
        },
        {
          "name": "1.3 Login (Generate JWT Token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"chief.accountant@invoicetech.vn\",\n  \"name\": \"Tran Thi Truong\",\n  \"role\": \"CHIEF_ACCOUNTANT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticate user and receive signed JWT Bearer token"
          },
          "response": []
        },
        {
          "name": "1.4 Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "View authenticated user session details"
          },
          "response": []
        },
        {
          "name": "1.5 Swagger UI Documentation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api-docs",
              "host": ["{{baseUrl}}"],
              "path": ["api-docs"]
            },
            "description": "Access interactive OpenAPI 3.0 Swagger UI"
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Core Invoice Operations",
      "item": [
        {
          "name": "2.1 Create Draft Invoice",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set('invoiceId', jsonData.data.id);",
                  "    console.log('Saved invoiceId:', jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Cong ty TNHH Cong Nghe Tuong Lai\",\n  \"customerEmail\": \"contact@tuonglai.tech\",\n  \"customerAddress\": \"Tang 8, Toa nha Keangnam, Pham Hung, Ha Noi\",\n  \"customerTaxCode\": \"0109988776\",\n  \"taxRate\": 10,\n  \"notes\": \"Thanh toan theo hop dong dich vu phan mem so HD-2026/08\",\n  \"items\": [\n    {\n      \"description\": \"Goi thiet ke kien truc Backend Cloud Microservices\",\n      \"quantity\": 1,\n      \"unitPrice\": 25000000\n    },\n    {\n      \"description\": \"Trien khai he thong CI/CD & Docker Kubernetes\",\n      \"quantity\": 2,\n      \"unitPrice\": 7500000\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/invoices",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices"]
            },
            "description": "Create a new invoice in DRAFT status with calculated totals."
          },
          "response": []
        },
        {
          "name": "2.2 Get Invoices (List & Filter)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invoices?page=1&limit=10&status=ISSUED",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "ISSUED" }
              ]
            },
            "description": "Retrieve paginated list of invoices with optional search and status filtering."
          },
          "response": []
        },
        {
          "name": "2.3 Get Invoice Details by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices", "{{invoiceId}}"]
            },
            "description": "Retrieve full invoice details with line items, Vietnamese amount in words, and replacement relationship history."
          },
          "response": []
        },
        {
          "name": "2.4 Update Draft Invoice",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Cong ty TNHH Cong Nghe Tuong Lai (Updated)\",\n  \"customerEmail\": \"finance@tuonglai.tech\",\n  \"taxRate\": 8,\n  \"items\": [\n    {\n      \"description\": \"Goi tu van va thiet ke Backend Cloud (Da dieu chinh)\",\n      \"quantity\": 1,\n      \"unitPrice\": 30000000\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices", "{{invoiceId}}"]
            },
            "description": "Update details and line items of a DRAFT invoice."
          },
          "response": []
        },
        {
          "name": "2.5 Issue Invoice (DRAFT -> ISSUED)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}/issue",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices", "{{invoiceId}}", "issue"]
            },
            "description": "Officially issue an invoice: assigns sequential invoice number (e.g. INV-202608-00001), records issuedAt timestamp, and permanently locks edits."
          },
          "response": []
        },
        {
          "name": "2.6 Download / View PDF Invoice",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}/pdf",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices", "{{invoiceId}}", "pdf"]
            },
            "description": "Generate and stream vector PDF invoice with company details, buyer info, items table, VietQR, and status badges."
          },
          "response": []
        },
        {
          "name": "2.7 Send Invoice via Email with PDF Attachment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipientEmail\": \"client@tuonglai.tech\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}/send-email",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices", "{{invoiceId}}", "send-email"]
            },
            "description": "Send responsive HTML invoice notification with attached PDF file."
          },
          "response": []
        },
        {
          "name": "2.8 Verify Invoice Authenticity",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}/verify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices", "{{invoiceId}}", "verify"]
            },
            "description": "Verify legality, issuer information, digital signature, and validity of an electronic invoice."
          },
          "response": []
        },
        {
          "name": "2.9 Get Invoice Audit History Trail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}/history",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices", "{{invoiceId}}", "history"]
            },
            "description": "Retrieve chronological audit activity history logs for an invoice."
          },
          "response": []
        },
        {
          "name": "2.10 Cancel Invoice (ISSUED -> CANCELED)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cancelReason\": \"Khach hang thay doi MST doanh nghiep va yeu cau lap hoa don thay the\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices", "{{invoiceId}}", "cancel"]
            },
            "description": "Cancel an issued invoice. Requires mandatory cancelReason."
          },
          "response": []
        },
        {
          "name": "2.11 Replace Invoice (ISSUED/CANCELED -> REPLACED)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cancelReason\": \"Thay the do sai thong tin Ma so thue\",\n  \"customerName\": \"Cong ty TNHH Cong Nghe Tuong Lai Viet Nam\",\n  \"customerTaxCode\": \"0109988776-001\",\n  \"taxRate\": 10,\n  \"items\": [\n    {\n      \"description\": \"Goi thiet ke kien truc Backend Cloud Microservices\",\n      \"quantity\": 1,\n      \"unitPrice\": 25000000\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}/replace",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices", "{{invoiceId}}", "replace"]
            },
            "description": "Mark original invoice as REPLACED and create a new replacement invoice linking replacedInvoiceId."
          },
          "response": []
        },
        {
          "name": "2.12 Delete Draft Invoice",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invoices/{{invoiceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices", "{{invoiceId}}"]
            },
            "description": "Delete draft invoice. Blocked for ISSUED/CANCELED/REPLACED invoices."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Batch Operations & Export",
      "item": [
        {
          "name": "3.1 Batch Issue Invoices",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoiceIds\": [\n    \"draft-id-1\",\n    \"draft-id-2\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/invoices/batch/issue",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices", "batch", "issue"]
            },
            "description": "Batch issue multiple draft invoices in an atomic database transaction."
          },
          "response": []
        },
        {
          "name": "3.2 Export Invoices as ZIP Bundle",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoiceIds\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/invoices/export/zip",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices", "export", "zip"]
            },
            "description": "Download a single compressed .zip file containing all selected vector PDF invoices."
          },
          "response": []
        },
        {
          "name": "3.3 Export Invoices CSV Report",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invoices/export/csv?status=ISSUED",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices", "export", "csv"],
              "query": [
                { "key": "status", "value": "ISSUED" }
              ]
            },
            "description": "Download Excel-compatible UTF-8 BOM CSV invoice register report."
          },
          "response": []
        },
        {
          "name": "3.4 Financial Dashboard & Analytics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invoices/analytics/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invoices", "analytics", "summary"]
            },
            "description": "Get summary metrics, revenue totals, status breakdown, and top customers by revenue."
          },
          "response": []
        }
      ]
    }
  ]
}
